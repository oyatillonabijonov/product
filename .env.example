# Server porti (nginx shu portga proxy qiladi)
PORT=3000

# Ma'lumotlar papkasi — baza fayli va yuklangan rasmlar shu yerda.
# Zaxira nusxa = shu papkani nusxalash.
DATA_DIR=/var/lib/product-store

# Xohlasangiz alohida ko'rsatiladi (odatda kerak emas):
# DATABASE_PATH=/var/lib/product-store/store.db
# IMAGES_DIR=/var/lib/product-store/images
