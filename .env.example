# Server porti (nginx shu portga proxy qiladi)
PORT=3000

# Ma'lumotlar papkasi — baza fayli va yuklangan rasmlar shu yerda.
# Zaxira nusxa = shu papkani nusxalash.
DATA_DIR=/var/lib/product-store

# Xohlasangiz alohida ko'rsatiladi (odatda kerak emas):
# DATABASE_PATH=/var/lib/product-store/store.db
# IMAGES_DIR=/var/lib/product-store/images

# Saytning tashqi manzili — remote MCP va OAuth metadatasida ishlatiladi.
# Bo'sh bo'lsa OAuth ulanmaydi (bearer token bilan /mcp baribir ishlaydi).
# Berilsa sahifa manzili (sitemap, canonical, Google redirect_uri, Secure cookie, HSTS) so'rovdagi
# Host/X-Forwarded-Host/X-Forwarded-Proto o'rniga shundan olinadi — sayt faqat shu domen va sxemada ishlaydi.
PUBLIC_URL=https://productstore.uz

# Ilova oldidagi reverse proxy hop'lari soni (req.ip va rate limit shundan). Sukut 1 —
# bitta Traefik/nginx. Proxy'siz to'g'ridan-to'g'ri ishlatilsa: false. `true` qabul qilinmaydi.
# TRUST_PROXY=1

# Tinglanadigan interfeys. Sukut: dev'da 127.0.0.1, production'da hammasi (konteyner).
# HOST=0.0.0.0
