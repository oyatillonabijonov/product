{
  "name": "taqsit-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node server/index.ts",
    "migrate": "node server/migrate.ts",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "lint": "node --experimental-strip-types -e \"await import('./server/mcp.ts'); await import('./server/oauth-provider.ts'); await import('./mcp/tools.ts')\" && react-router typegen && tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run",
    "import:d1": "node server/import-d1.ts",
    "backup": "node server/backup.ts",
    "mcp": "node mcp/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-router/dev": "^7",
    "@react-router/express": "^7",
    "@tailwindcss/vite": "^4.1.14",
    "better-sqlite3": "^13.0.3",
    "bot-avatars": "^0.1.1",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "isbot": "^5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7",
    "vite": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.18"
  }
}
