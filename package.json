{
  "name": "taqsit-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node server/index.ts",
    "migrate": "node server/migrate.ts",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "lint": "react-router typegen && tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run",
    "import:d1": "node server/import-d1.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/dev": "^7",
    "@react-router/express": "^7",
    "@react-router/node": "^7",
    "@tailwindcss/vite": "^4.1.14",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "isbot": "^5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.18"
  }
}
